# ----------------------------------------------------------------------------
# Connect Club — variáveis de ambiente
# Copia este ficheiro para .env.local e preenche com as tuas chaves da EuPago.
#
# Sem chaves o site arranca em modo demonstração: o checkout explica que o
# pagamento ainda não está ativo, em vez de rebentar.
# ----------------------------------------------------------------------------

# URL público do site — usado nos redirecionamentos de sucesso/falha.
# Em produção tem de ser o domínio real, com https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "sandbox" para testes, "production" quando for a sério.
EUPAGO_ENV=sandbox

# API Key do canal. Backoffice → Canais → Listagem de canais.
# Formato xxxx-xxxx-xxxx-xxxx-xxxx.
EUPAGO_API_KEY=

# Credenciais OAuth — só necessárias para cancelar subscrições
# (endpoint /management/v1.02/subscriptions/revoke).
EUPAGO_CLIENT_ID=
EUPAGO_CLIENT_SECRET=

# Chave de encriptação/assinatura dos webhooks 2.0, gerada no backoffice.
# Sem isto as notificações são aceites mas não são verificadas — configura
# sempre em produção.
EUPAGO_WEBHOOK_SECRET=

# Dia do mês em que a mensalidade é cobrada (1-28).
# Se ficar vazio, usa o dia em que o cliente se inscreveu.
EUPAGO_COLLECTION_DAY=

# Horizonte da autorização de débito, em anos (predefinido: 10).
# Não é fidelização: quem cancela é revogado muito antes disto.
EUPAGO_SUBSCRIPTION_YEARS=10

# Quando um pagamento é confirmado, o evento normalizado é reencaminhado em
# POST JSON para este URL (n8n, Make, Zapier, Google Sheets...). Opcional —
# sem isto os eventos ficam apenas no log do servidor.
PAYMENT_EVENT_WEBHOOK_URL=
