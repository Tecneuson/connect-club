# ----------------------------------------------------------------------------
# Connect Club — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com as suas chaves da Stripe.
# ----------------------------------------------------------------------------

# Chave secreta da Stripe (Dashboard > Desenvolvedores > Chaves de API)
STRIPE_SECRET_KEY=sk_test_xxx

# IDs de preço (Price ID) de cada plano de Personal Training — cria produtos
# recorrentes (mensais) na Stripe e cola aqui o ID que começa com "price_..."
# 1x/semana = 142,80 € · 2x/semana = 268,80 € · 3x/semana = 378 €
STRIPE_PRICE_PT_1X=price_xxx
STRIPE_PRICE_PT_2X=price_xxx
STRIPE_PRICE_PT_3X=price_xxx

# URL pública do site (usada nos redirecionamentos de sucesso/cancelamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
