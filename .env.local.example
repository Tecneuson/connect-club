# ----------------------------------------------------------------------------
# Connect Club — variáveis de ambiente
# Copia este ficheiro para .env.local e preenche com as tuas chaves.
#
# O site suporta dois gateways de subscrição. Sem chaves nenhumas arranca em
# modo demonstração (os botões explicam que o pagamento ainda não está ativo).
# ----------------------------------------------------------------------------

# Gateway ativo: "eupago" (predefinido) ou "stripe".
PAYMENT_PROVIDER=eupago

# URL público do site — usado nos redirecionamentos de sucesso/falha e nos
# webhooks. Em produção tem de ser o domínio real, com https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# EuPago
# Backoffice: Canais → Listagem de canais (é lá que está a API Key)
# ----------------------------------------------------------------------------

# "sandbox" para testes, "production" quando for a sério.
EUPAGO_ENV=sandbox

# API Key do canal. Formato xxxx-xxxx-xxxx-xxxx-xxxx.
EUPAGO_API_KEY=

# Credenciais OAuth — só necessárias para cancelar subscrições
# (endpoint /management/v1.02/subscriptions/revoke).
EUPAGO_CLIENT_ID=
EUPAGO_CLIENT_SECRET=

# Chave de encriptação/assinatura dos webhooks 2.0, gerada no backoffice.
# Sem isto as notificações são aceites mas não são verificadas — configura
# sempre em produção.
EUPAGO_WEBHOOK_SECRET=

# Dia do mês em que a mensalidade é cobrada (1-28).
# Se ficar vazio, usa o dia em que o cliente se inscreveu.
EUPAGO_COLLECTION_DAY=

# Horizonte da autorização de débito, em anos (predefinido: 10).
# Não é fidelização: quem cancela é revogado muito antes disto.
EUPAGO_SUBSCRIPTION_YEARS=10


# ----------------------------------------------------------------------------
# Stripe (alternativa — só usada com PAYMENT_PROVIDER=stripe)
# ----------------------------------------------------------------------------

# Chave secreta (Dashboard → Programadores → Chaves de API)
STRIPE_SECRET_KEY=

# Price IDs de cada plano. Cria produtos recorrentes (mensais) na Stripe e cola
# aqui o ID que começa por "price_...".
# 1x/semana = 142,80 € · 2x/semana = 268,80 € · 3x/semana = 378 €
STRIPE_PRICE_PT_1X=
STRIPE_PRICE_PT_2X=
STRIPE_PRICE_PT_3X=


# ----------------------------------------------------------------------------
# Destino dos eventos de pagamento (opcional)
# ----------------------------------------------------------------------------

# Quando um pagamento é confirmado, o evento normalizado é reencaminhado em
# POST JSON para este URL (n8n, Make, Zapier, Google Sheets...). Sem isto os
# eventos ficam apenas no log do servidor.
PAYMENT_EVENT_WEBHOOK_URL=
