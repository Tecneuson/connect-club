# ----------------------------------------------------------------------------
# Connect Club — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com as suas chaves da Stripe.
# ----------------------------------------------------------------------------

# Chave secreta da Stripe (Dashboard > Desenvolvedores > Chaves de API)
STRIPE_SECRET_KEY=sk_test_xxx

# IDs de preço (Price ID) de cada plano — crie produtos recorrentes na Stripe
# e cole aqui o ID que começa com "price_..."
STRIPE_PRICE_ESSENCIAL=price_xxx
STRIPE_PRICE_PERFORMANCE=price_xxx
STRIPE_PRICE_ILIMITADO=price_xxx

# URL pública do site (usada nos redirecionamentos de sucesso/cancelamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
